@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model MatTicket.Pages.Account.ProfileModel
@{
    ViewData["Width"] = "narrow";
    var themes = new List<SelectListItem> { new("System", "system"), new("Hell", "light"), new("Dunkel", "dark") };
}

<form class="mat-form" method="post" asp-page-handler="Profile" novalidate>
    <mt-card title="Profil" icon="user">
        <mt-summary />
        <div class="mat-form__grid">
            <mt-input for="Profile.DisplayName" label="Name" autocomplete="name" />
            <mt-input for="Profile.Phone" label="Telefon" type="tel" autocomplete="tel" />
            <div class="mat-field">
                <span class="mat-label">E-Mail-Adresse</span>
                <input class="mat-input" value="@Model.Email" disabled />
                <span class="mat-hint">@(Model.FromEntra ? "Das Konto kommt aus Microsoft Entra ID." : "Die Adresse ändert die Administration.")</span>
            </div>
            <mt-select for="Profile.Theme" label="Darstellung" items="themes" hint="Der Knopf unten im Menü stellt das Gleiche ein." />
            <mt-textarea for="Profile.Signature" label="Signatur" rows="3" full="true" hint="Steht unter deinen Antworten an Kunden. Leer: dein Name." />
        </div>
    </mt-card>
    <mt-buttons back-href="/" />
</form>

<form class="mat-form" method="post" asp-page-handler="Password" novalidate>
    <mt-card title="@(Model.HasPassword ? "Passwort ändern" : "Passwort festlegen")" icon="lock">
        @if (!Model.HasPassword)
        {
            <p class="mat-muted">Du meldest dich mit Microsoft an. Ein Passwort brauchst du nur als Notzugang, falls die Anmeldung mit Microsoft einmal nicht geht.</p>
        }
        <div class="mat-form__grid">
            @if (Model.HasPassword)
            {
                <mt-input for="Password.Current" label="Aktuelles Passwort" type="password" autocomplete="current-password" full="true" required="true" />
            }
            <mt-input for="Password.New" label="Neues Passwort" type="password" autocomplete="new-password" hint="Mindestens 10 Zeichen." />
            <mt-input for="Password.Repeat" label="Neues Passwort wiederholen" type="password" autocomplete="new-password" />
        </div>
    </mt-card>
    <mt-buttons save-text="Passwort speichern" save-icon="key" back-href="/" />
</form>
