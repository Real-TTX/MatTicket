@page
@model MatTicket.Pages.Account.EntraCallbackModel
@{
    Layout = "_Bare";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Kein Zugriff</h1>
        <p class="mat-muted">@Model.Reason</p>
    </div>
    <div class="mat-btn-row mat-btn-row--plain">
        <a class="mat-btn mat-btn--secondary mat-btn--block" href="/Account/Login">@Ui.Icon("back")<span>Zur Anmeldung</span></a>
    </div>
</div>
