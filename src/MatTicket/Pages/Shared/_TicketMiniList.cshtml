@model List<Ticket>
@*
    The tickets of a company or a contact, newest first: a short list of rows that open the ticket.
*@
<mt-card title="Tickets" icon="ticket">
    @if (Model.Count == 0)
    {
        <p class="mat-muted">Keine Tickets.</p>
    }
    else
    {
        <ul class="mat-itemlist">
            @foreach (var t in Model)
            {
                <li class="mat-item">
                    <a class="mat-item__main" href="/Tickets/Details?id=@t.Id">
                        <span class="mat-item__lead">@Ui.Icon("ticket")</span>
                        <span class="mat-item__body"><span class="mat-item__title">@t.Subject</span><span class="mat-item__text">@t.Number · @Labels.Of(t.Status) · @Fmt.Moment(t.LastActivityDate)</span></span>
                        <span class="mat-item__end">@Ui.Icon("chevron-right", "mat-item__chevron")</span>
                    </a>
                </li>
            }
        </ul>
    }
</mt-card>
