@page
@model MatTicket.Pages.Admin.Ai.Profiles.EditModel
@using MatTicket.Core.Ai
@{
    var providers = Controls.Options.Of<AiProvider>(Labels.Of);
    var p = Model.Profile;
    var cg = Model.ChatGpt;
}

<form class="mat-form" method="post" asp-page-handler="" novalidate data-ai-profile data-profile-id="@Model.Id">
    <input type="hidden" name="Id" value="@Model.Id" />
    <mt-summary />
    <mt-card title="Verbindung" icon="bot">
        <div class="mat-form__grid">
            <mt-input for="Input.Name" label="Name" required="true" hint="z. B. „Mistral EU“, „DeepSeek Flash“, „OpenRouter kostenlos“, „ChatGPT“." />
            <mt-radios for="Input.Provider" label="Art" items="providers" full="true" />
            <div class="mat-field" data-show-if="Input.Provider" data-show-value="OpenAiCompatible">
                <label class="mat-label" for="Input_Preset">Vorlage</label>
                <select class="mat-select" id="Input_Preset" name="Input.Preset" data-ai-preset>
                    @foreach (var preset in AiPresets.All)
                    {
                        <option value="@preset.Id" selected="@(Model.Input.Preset == preset.Id)" data-url="@preset.Url" data-model="@preset.ModelHint">@preset.Label (@preset.Region)</option>
                    }
                </select>
                <span class="mat-hint">Füllt die Adresse vor. Mistral verarbeitet in der EU.</span>
            </div>
            <mt-input for="Input.BaseUrl" label="Adresse der Schnittstelle" type="url" full="true" show-if="Input.Provider" show-value="OpenAiCompatible" data-ai-url hint="Die Adresse, an die /chat/completions und /models angehängt werden." />
            <mt-input for="Input.ApiKey" label="API-Schlüssel" type="password" autocomplete="off" full="true" show-if="Input.Provider" show-value="OpenAiCompatible" data-ai-key
                      hint="@(Model.HasKey && p?.Provider == AiProvider.OpenAiCompatible ? "Ein Schlüssel ist gespeichert (verschlüsselt, nie wieder sichtbar). Leer lassen, um ihn zu behalten." : "Wird verschlüsselt im Datenvolume gespeichert – nie in der Datenbank, nie in einem Backup, nie im Browser.")" />
            @if (Model.HasKey && p?.Provider == AiProvider.OpenAiCompatible)
            {
                <mt-switch for="Input.RemoveKey" label="Gespeicherten Schlüssel entfernen" full="true" />
            }
            <div class="mat-field mat-field--full">
                <label class="mat-label" for="Input_Model">Modell <span class="mat-req" aria-hidden="true">*</span></label>
                <input class="mat-input" id="Input_Model" name="Input.Model" value="@Model.Input.Model" list="ai-models" autocomplete="off" required data-ai-model />
                <datalist id="ai-models"></datalist>
                <span class="mat-hint" data-ai-models-info>„Modelle laden“ fragt den Anbieter, welche Modelle es gibt. Kostenlos ist nur markiert, was der Anbieter so angibt.</span>
                <div class="mat-actions">
                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-ai-load-models>@Ui.Icon("download")<span>Modelle laden</span></button>
                </div>
                <ul class="mt-chips" data-ai-models-list aria-label="Modelle des Anbieters"></ul>
            </div>
            <mt-textarea for="Input.Note" label="Notiz" rows="2" full="true" />
        </div>
    </mt-card>
    <mt-buttons back-href="/Admin/Ai/Profiles" delete-url="@(p is null ? null : Url.Page("/Admin/Ai/Profiles/Edit", "Delete", new { id = Model.Id }))" delete-confirm="Dieses Profil löschen? Sein Schlüssel und seine ChatGPT-Anmeldung werden mit gelöscht.">
        @if (p is { IsActive: false })
        {
            <button type="submit" formaction="@Url.Page("/Admin/Ai/Profiles/Edit", "Activate", new { id = Model.Id })" formnovalidate class="mat-btn mat-btn--secondary">@Ui.Icon("check")<span>Aktivieren</span></button>
        }
    </mt-buttons>
</form>

@if (p is { Provider: AiProvider.ChatGpt })
{
    <mt-card title="Anmeldung bei ChatGPT" icon="message-circle" sub="Mit einem Code, wie bei Codex. Jedes ChatGPT-Profil hat seine eigene Anmeldung.">
        @if (cg is { Connected: true })
        {
            <p>@Ui.Pill("angemeldet", "ok", "check") @cg.Email @(string.IsNullOrEmpty(cg.Plan) ? "" : $"({cg.Plan})")</p>
            <dl class="mat-kv">
                <dt>Zugriff gültig bis</dt><dd>@Fmt.Moment(cg.AccessExpiresAt) (wird vorher automatisch erneuert)</dd>
                <dt>Angemeldet seit</dt><dd>@Fmt.Moment(cg.ConnectedAt)</dd>
                @if (cg.LastRefresh is not null) { <dt>Zuletzt erneuert</dt><dd>@Fmt.Moment(cg.LastRefresh)</dd> }
            </dl>
            <form method="post" asp-page-handler="ChatGptLogout" asp-route-id="@p.Id" class="mat-actions">
                <button type="submit" class="mat-btn mat-btn--ghost" data-confirm="Von ChatGPT abmelden?" data-confirm-ok="Abmelden">@Ui.Icon("logout")<span>Abmelden</span></button>
            </form>
        }
        else if (cg?.Pending is { } pending)
        {
            <div class="mat-alert mat-alert--info" data-chatgpt-poll="/api/admin/ai/profiles/@p.Id/chatgpt">
                @Ui.Icon("key")
                <div class="mat-alert__body">
                    <p>1. Öffne <a href="@pending.VerificationUrl" target="_blank" rel="noopener noreferrer">@pending.VerificationUrl</a> und melde dich bei ChatGPT an.</p>
                    <p>2. Gib diesen Code ein: <strong class="mat-mono mt-code-big">@pending.UserCode</strong> <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-copy="@pending.UserCode" aria-label="Code kopieren">@Ui.Icon("copy")</button></p>
                    <p class="mat-muted" data-chatgpt-state>Warte auf die Bestätigung … (gültig bis @Fmt.Time(pending.ExpiresAt))</p>
                </div>
            </div>
        }
        else
        {
            @if (cg?.Error is { } err) { <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">@err</div></div> }
            @if (cg?.LoginError is { } loginErr) { <div class="mat-alert mat-alert--danger">@Ui.Icon("x-circle")<div class="mat-alert__body">@loginErr</div></div> }
            <p class="mat-muted">Nicht angemeldet.</p>
            <form method="post" asp-page-handler="ChatGptStart" asp-route-id="@p.Id" class="mat-actions">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("enter")<span>Mit ChatGPT anmelden</span></button>
            </form>
        }
    </mt-card>
}

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
