@page
@model MatTicket.Pages.Admin.Users.EditModel
@{
    var roles = Controls.Options.Of<UserRole>(Labels.Of);
    var d = Model.Details;
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mt-summary />
    <mt-tabs id="user-tabs" label="Bereiche des Benutzers">
        <mt-tab id="account" title="Konto" icon="user">
            <mt-card title="Konto" icon="user" sub="@(Model.IsMe ? "das bist du" : null)">
                <div class="mat-form__grid">
                    <mt-input for="Input.DisplayName" label="Name" required="true" autocomplete="off" />
                    <mt-input for="Input.Email" label="E-Mail-Adresse (Anmeldename)" type="email" inputmode="email" required="true" autocomplete="off" />
                    <mt-input for="Input.Phone" label="Telefon" type="tel" />
                    <mt-select for="Input.Role" label="Rolle" items="roles" hint="Administratoren richten alles ein (Formulare, Kategorien, Teams, CRM, Sync, KI, Anmeldung). Service-Mitarbeiter bearbeiten die Tickets ihrer Abteilungen und pflegen das CRM. Anfragende sehen nur das Hilfe-Portal und ihre eigenen Anfragen." />
                    <mt-switch for="Input.IsActive" label="Darf sich anmelden" full="true" />
                    <mt-input for="Input.Password" label="@(Model.Account is null ? "Passwort (Notzugang)" : "Neues Passwort")" type="password" autocomplete="new-password"
                              hint="@(Model.Account is null ? "Mindestens 10 Zeichen. Leer lassen, wenn sich die Person nur mit Microsoft anmeldet." : "Leer lassen, um das Passwort zu behalten. Mit einem neuen Passwort werden alle Sitzungen der Person beendet.")" />
                </div>
            </mt-card>
        </mt-tab>
        <mt-tab id="teams" title="Teams" icon="users">
            <mt-card title="Teams" icon="users" sub="Ein Mitarbeiter sieht die Tickets der Abteilungen seiner Teams.">
                <div class="mat-form__grid">
                    <mt-picker for="Input.Teams" label="Teams" items="Model.TeamItems" multiple="true" placeholder="Kein Team" full="true" />
                </div>
            </mt-card>
        </mt-tab>
    </mt-tabs>

    <mt-buttons back-href="/Admin/Users" delete-url="@(Model.Account is null || Model.IsMe ? null : Url.Page("/Admin/Users/Edit", "Delete", new { id = Model.Id }))" delete-confirm="Diesen Benutzer löschen? Er kann sich nicht mehr anmelden, seine Einträge bleiben erhalten." />
</form>

@if (d is not null)
{
    <mt-card title="Anmeldung" icon="shield">
        <dl class="mat-kv">
            <dt>Art</dt><dd>@Labels.Of(d.User.Source)</dd>
            <dt>Zwei-Faktor-Anmeldung</dt><dd>@(d.User.Totp is { IsConfirmed: true } ? "an (Authenticator-App)" : "aus")</dd>
            <dt>Letzte Anmeldung</dt><dd>@(d.User.LastLoginDate is null ? "noch nie" : Fmt.Moment(d.User.LastLoginDate))</dd>
            <dt>Offene Sitzungen</dt><dd>@d.Sessions</dd>
            <dt>Falsche Anmeldungen</dt><dd>@d.User.FailedLogins@(d.IsLocked ? $" · gesperrt bis {Fmt.Moment(d.User.LockoutEndDate)}" : "")</dd>
        </dl>
        <form method="post" class="mat-actions">
            @if (d.IsLocked || d.User.FailedLogins > 0)
            {
                <button type="submit" asp-page-handler="Unlock" asp-route-id="@Model.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("lock-open")<span>Sperre aufheben</span></button>
            }
            @if (d.User.Totp is { IsConfirmed: true })
            {
                <button type="submit" asp-page-handler="ResetTotp" asp-route-id="@Model.Id" class="mat-btn mat-btn--secondary" data-confirm="Die Zwei-Faktor-Anmeldung dieser Person abschalten? Sie kann sie danach neu einrichten." data-confirm-ok="Abschalten">@Ui.Icon("shield")<span>Zwei Faktoren zurücksetzen</span></button>
            }
            @if (d.Sessions > 0)
            {
                <button type="submit" asp-page-handler="EndSessions" asp-route-id="@Model.Id" class="mat-btn mat-btn--ghost" data-confirm="Alle Sitzungen dieser Person beenden?" data-confirm-ok="Beenden">@Ui.Icon("logout")<span>Alle Sitzungen beenden</span></button>
            }
        </form>
    </mt-card>
}
